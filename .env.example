# Local host connection; docker-compose overrides this to the internal `db` service.
# On Runflare, replace with the private PostgreSQL service hostname and credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sensishop
DB_POOL_MAX=5

# Generate a unique 32+ byte secret before production. Never commit .env.
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SECURE=false

# First admin is created once with `npm run db:seed-admin`.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=change-this-before-running-the-seed

# Public origin is optional. Use the final domain only in deployment settings.
APP_URL=http://localhost:3000

# Object storage. Local development uses MinIO from docker-compose.yml.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sensishop-media
S3_ACCESS_KEY_ID=sensishop-local
S3_SECRET_ACCESS_KEY=change-this-local-secret
S3_FORCE_PATH_STYLE=true

# Payments stay disabled unless a real provider adapter is implemented and
# configured. `mock` is permitted only in development.
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
